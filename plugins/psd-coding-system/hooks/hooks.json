{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "if": "tool_input.file_path matches '\\.(?:py|json)$'",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/post-edit-validate.sh"],
            "continueOnBlock": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/redact-secrets.sh"],
            "timeout": 5,
            "outputReplace": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verify-gate-stop-hook.sh"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact-context.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); wp=$(printf \"%s\" \"$input\" | jq -r \".worktree_path // .path // empty\" 2>/dev/null); if [ -n \"$wp\" ] && [ -d \"$wp\" ] && [ -f .env ]; then if ln -sf \"$(pwd)/.env\" \"$wp/.env\"; then echo \"Symlinked .env into worktree\" >&2; else echo \"Warning: failed to symlink .env\" >&2; fi; fi; true",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Worktree removed: ${worktree_path:-unknown} ==='",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
